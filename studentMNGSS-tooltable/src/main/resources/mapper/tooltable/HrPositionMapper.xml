<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.studentMNGSS.tooltable.mapper.HrPositionMapper">

    <resultMap type="HrPosition" id="HrPositionResult">
        <result property="positionId"    column="position_id"    />
        <result property="positionCode"  column="position_code"  />
        <result property="positionName"  column="position_name"  />
        <result property="deptId"        column="dept_id"        />
        <result property="deptName"      column="dept_name"      />
        <result property="positionSort"  column="position_sort"  />
        <result property="status"        column="status"         />
        <result property="delFlag"       column="del_flag"       />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>

    <sql id="selectHrPositionVo">
        select p.position_id, p.position_code, p.position_name, p.dept_id, d.dept_name, p.position_sort, p.status, p.del_flag, p.create_by, p.create_time, p.update_by, p.update_time, p.remark
        from hr_position p
        left join sys_dept d on p.dept_id = d.dept_id
    </sql>

    <select id="selectHrPositionList" parameterType="HrPosition" resultMap="HrPositionResult">
        <include refid="selectHrPositionVo"/>
        <where>
            p.del_flag = '0'
            <if test="positionCode != null  and positionCode != ''"> and p.position_code like concat('%', #{positionCode}, '%')</if>
            <if test="positionName != null  and positionName != ''"> and p.position_name like concat('%', #{positionName}, '%')</if>
            <if test="deptId != null "> and p.dept_id = #{deptId}</if>
            <if test="status != null  and status != ''"> and p.status = #{status}</if>
        </where>
        order by p.position_sort
    </select>

    <select id="selectHrPositionByPositionId" parameterType="Long" resultMap="HrPositionResult">
        <include refid="selectHrPositionVo"/>
        where p.position_id = #{positionId}
    </select>

    <select id="selectHrPositionByDeptId" parameterType="Long" resultMap="HrPositionResult">
        <include refid="selectHrPositionVo"/>
        where p.dept_id = #{deptId} and p.del_flag = '0' and p.status = '0'
        order by p.position_sort
    </select>

    <select id="selectHrPositionAll" resultMap="HrPositionResult">
        <include refid="selectHrPositionVo"/>
        where p.del_flag = '0' and p.status = '0'
        order by p.position_sort
    </select>

    <select id="checkPositionCodeUnique" parameterType="String" resultMap="HrPositionResult">
        <include refid="selectHrPositionVo"/>
        where p.position_code = #{positionCode} and p.del_flag = '0' limit 1
    </select>

    <select id="checkPositionNameUnique" parameterType="HrPosition" resultMap="HrPositionResult">
        <include refid="selectHrPositionVo"/>
        where p.position_name = #{positionName} and p.dept_id = #{deptId} and p.del_flag = '0' limit 1
    </select>

    <insert id="insertHrPosition" parameterType="HrPosition" useGeneratedKeys="true" keyProperty="positionId">
        insert into hr_position
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="positionCode != null and positionCode != ''">position_code,</if>
            <if test="positionName != null and positionName != ''">position_name,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="positionSort != null">position_sort,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="positionCode != null and positionCode != ''">#{positionCode},</if>
            <if test="positionName != null and positionName != ''">#{positionName},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="positionSort != null">#{positionSort},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateHrPosition" parameterType="HrPosition">
        update hr_position
        <trim prefix="SET" suffixOverrides=",">
            <if test="positionCode != null and positionCode != ''">position_code = #{positionCode},</if>
            <if test="positionName != null and positionName != ''">position_name = #{positionName},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="positionSort != null">position_sort = #{positionSort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where position_id = #{positionId}
    </update>

    <delete id="deleteHrPositionByPositionId" parameterType="Long">
        update hr_position set del_flag = '2' where position_id = #{positionId}
    </delete>

    <delete id="deleteHrPositionByPositionIds" parameterType="String">
        update hr_position set del_flag = '2' where position_id in
        <foreach item="positionId" collection="array" open="(" separator="," close=")">
            #{positionId}
        </foreach>
    </delete>
</mapper>
