<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.studentMNGSS.tooltable.mapper.HrSalaryRecordMapper">

    <resultMap type="HrSalaryRecord" id="HrSalaryRecordResult">
        <result property="recordId"       column="record_id"       />
        <result property="recordCode"     column="record_code"     />
        <result property="employeeId"     column="employee_id"     />
        <result property="employeeName"   column="employee_name"   />
        <result property="employeeCode"   column="employee_code"   />
        <result property="standardId"     column="standard_id"     />
        <result property="standardName"   column="standard_name"   />
        <result property="salaryMonth"    column="salary_month"    />
        <result property="baseAmount"     column="base_amount"     />
        <result property="bonusAmount"    column="bonus_amount"    />
        <result property="deductAmount"   column="deduct_amount"   />
        <result property="actualAmount"   column="actual_amount"   />
        <result property="status"         column="status"          />
        <result property="reviewer"       column="reviewer"        />
        <result property="reviewTime"     column="review_time"     />
        <result property="delFlag"        column="del_flag"        />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
        <result property="remark"         column="remark"          />
    </resultMap>

    <resultMap type="HrSalaryRecordDetail" id="HrSalaryRecordDetailResult">
        <result property="detailId"       column="detail_id"       />
        <result property="recordId"       column="record_id"       />
        <result property="itemId"         column="item_id"         />
        <result property="itemName"       column="item_name"       />
        <result property="itemType"       column="item_type"       />
        <result property="amount"         column="amount"          />
    </resultMap>

    <sql id="selectHrSalaryRecordVo">
        select r.record_id, r.record_code, r.employee_id, e.employee_name, e.employee_code,
               r.standard_id, s.standard_name, r.salary_month, r.base_amount, r.bonus_amount,
               r.deduct_amount, r.actual_amount, r.status, r.reviewer, r.review_time, r.del_flag,
               r.create_by, r.create_time, r.update_by, r.update_time, r.remark
        from hr_salary_record r
        left join hr_employee e on r.employee_id = e.employee_id
        left join hr_salary_standard s on r.standard_id = s.standard_id
    </sql>

    <select id="selectHrSalaryRecordList" parameterType="HrSalaryRecord" resultMap="HrSalaryRecordResult">
        <include refid="selectHrSalaryRecordVo"/>
        <where>
            r.del_flag = '0'
            <if test="recordCode != null  and recordCode != ''"> and r.record_code like concat('%', #{recordCode}, '%')</if>
            <if test="employeeId != null "> and r.employee_id = #{employeeId}</if>
            <if test="employeeName != null  and employeeName != ''"> and e.employee_name like concat('%', #{employeeName}, '%')</if>
            <if test="salaryMonth != null  and salaryMonth != ''"> and r.salary_month = #{salaryMonth}</if>
            <if test="status != null  and status != ''"> and r.status = #{status}</if>
            <if test="deptIdFirst != null"> and e.dept_id_first = #{deptIdFirst}</if>
            <if test="deptIdSecond != null"> and e.dept_id_second = #{deptIdSecond}</if>
            <if test="deptIdThird != null"> and e.dept_id_third = #{deptIdThird}</if>
        </where>
        order by r.create_time desc
    </select>

    <select id="selectHrSalaryRecordPendingReviewList" parameterType="HrSalaryRecord" resultMap="HrSalaryRecordResult">
        <include refid="selectHrSalaryRecordVo"/>
        <where>
            r.del_flag = '0' and r.status = '0'
            <if test="recordCode != null  and recordCode != ''"> and r.record_code like concat('%', #{recordCode}, '%')</if>
            <if test="employeeName != null  and employeeName != ''"> and e.employee_name like concat('%', #{employeeName}, '%')</if>
            <if test="salaryMonth != null  and salaryMonth != ''"> and r.salary_month = #{salaryMonth}</if>
        </where>
        order by r.create_time desc
    </select>

    <select id="selectHrSalaryRecordByRecordId" parameterType="Long" resultMap="HrSalaryRecordResult">
        <include refid="selectHrSalaryRecordVo"/>
        where r.record_id = #{recordId}
    </select>

    <select id="selectHrSalaryRecordDetailByRecordId" parameterType="Long" resultMap="HrSalaryRecordDetailResult">
        select d.detail_id, d.record_id, d.item_id, i.item_name, i.item_type, d.amount
        from hr_salary_record_detail d
        left join hr_salary_item i on d.item_id = i.item_id
        where d.record_id = #{recordId}
        order by i.item_sort
    </select>

    <select id="selectMaxRecordCode" parameterType="String" resultType="String">
        select max(record_code) from hr_salary_record where record_code like concat(#{prefix}, '%')
    </select>

    <select id="checkEmployeeMonthRecord" resultMap="HrSalaryRecordResult">
        select record_id from hr_salary_record
        where employee_id = #{employeeId} and salary_month = #{salaryMonth} and del_flag = '0' limit 1
    </select>

    <insert id="insertHrSalaryRecord" parameterType="HrSalaryRecord" useGeneratedKeys="true" keyProperty="recordId">
        insert into hr_salary_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="recordCode != null and recordCode != ''">record_code,</if>
            <if test="employeeId != null">employee_id,</if>
            <if test="standardId != null">standard_id,</if>
            <if test="salaryMonth != null and salaryMonth != ''">salary_month,</if>
            <if test="baseAmount != null">base_amount,</if>
            <if test="bonusAmount != null">bonus_amount,</if>
            <if test="deductAmount != null">deduct_amount,</if>
            <if test="actualAmount != null">actual_amount,</if>
            <if test="status != null">status,</if>
            <if test="reviewer != null">reviewer,</if>
            <if test="reviewTime != null">review_time,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="recordCode != null and recordCode != ''">#{recordCode},</if>
            <if test="employeeId != null">#{employeeId},</if>
            <if test="standardId != null">#{standardId},</if>
            <if test="salaryMonth != null and salaryMonth != ''">#{salaryMonth},</if>
            <if test="baseAmount != null">#{baseAmount},</if>
            <if test="bonusAmount != null">#{bonusAmount},</if>
            <if test="deductAmount != null">#{deductAmount},</if>
            <if test="actualAmount != null">#{actualAmount},</if>
            <if test="status != null">#{status},</if>
            <if test="reviewer != null">#{reviewer},</if>
            <if test="reviewTime != null">#{reviewTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <insert id="insertHrSalaryRecordDetail" parameterType="HrSalaryRecordDetail" useGeneratedKeys="true" keyProperty="detailId">
        insert into hr_salary_record_detail (record_id, item_id, amount)
        values (#{recordId}, #{itemId}, #{amount})
    </insert>

    <update id="updateHrSalaryRecord" parameterType="HrSalaryRecord">
        update hr_salary_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="baseAmount != null">base_amount = #{baseAmount},</if>
            <if test="bonusAmount != null">bonus_amount = #{bonusAmount},</if>
            <if test="deductAmount != null">deduct_amount = #{deductAmount},</if>
            <if test="actualAmount != null">actual_amount = #{actualAmount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="reviewer != null">reviewer = #{reviewer},</if>
            <if test="reviewTime != null">review_time = #{reviewTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where record_id = #{recordId}
    </update>

    <delete id="deleteHrSalaryRecordByRecordId" parameterType="Long">
        update hr_salary_record set del_flag = '2' where record_id = #{recordId}
    </delete>

    <delete id="deleteHrSalaryRecordByRecordIds" parameterType="String">
        update hr_salary_record set del_flag = '2' where record_id in
        <foreach item="recordId" collection="array" open="(" separator="," close=")">
            #{recordId}
        </foreach>
    </delete>

    <delete id="deleteHrSalaryRecordDetailByRecordId" parameterType="Long">
        delete from hr_salary_record_detail where record_id = #{recordId}
    </delete>
</mapper>
