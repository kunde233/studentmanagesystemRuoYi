    <delete id="deleteHrEmployeeByEmployeeId" parameterType="Long">
        update hr_employee set status = '2', del_flag = '2' where employee_id = #{employeeId}
    </delete>

    <delete id="deleteHrEmployeeByEmployeeIds" parameterType="String">
        update hr_employee set status = '2', del_flag = '2' where employee_id in
